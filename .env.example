# Server
PORT=8787
HOST=127.0.0.1

# Where the SQLite database lives. Defaults to ./data
# DATA_DIR=/var/lib/shelclaw

# Optional. When set, every /api request must send
#   Authorization: Bearer <token>   (or ?token=<token> for SSE)
# Leave empty for local-only use.
APP_TOKEN=

# Optional overrides for CLI bridge providers
# OPENCODE_BIN=opencode
# CLAUDE_BIN=claude
